# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# Genomes (cached locally per-build by seq_loader)
.cache/
*.fa
*.fa.gz
*.fa.fai
*.fai

# Results (generated by the test_* scripts; regenerate, don't commit) -- except the
# small benchmark result tables kept as blog supplementary data (re-included below).
results/**
out/
*.png
*.pdf

# Models
models/
*.ckpt
*.safetensors
*.pth
*.pt

# IDE / OS
.idea/
.vscode/
.DS_Store
*.swp

# Notebooks
.ipynb_checkpoints/

# Committed supplementary benchmark result tables (Borzoi fold/ensemble study).
# Directories are re-included first so Git descends into the otherwise-ignored
# results/ tree; only small CSV/summary/markdown tables are kept (plots stay ignored).
!results/**/
!results/**/*_results.csv
!results/**/*_correlation_summary.csv
!results/**/*_summary.txt
!results/*.md
